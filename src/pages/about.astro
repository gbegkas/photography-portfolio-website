---
import Layout from "../components/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="About — Light & Lens">
  <Navbar />

  <div class="about-page">
    <div class="about-inner">
      <div class="about-label fade-up">About</div>
      <h1 class="about-heading fade-up fade-up-delay-1">
        The eye behind<br/>
        <em>the lens</em>
      </h1>
      <div class="about-divider fade-up fade-up-delay-2"></div>
      <div class="about-body fade-up fade-up-delay-2">
        <p>
          Hi, I'm George — a software engineer by day and photographer by passion. My camera goes wherever life takes
          me — always looking for the moments that feel too good to let slip by.
        </p>
        <p>
          Photography crept up on me gradually. What started as a creative escape from code and screens slowly became
          one of the most meaningful ways I engage with the world around me. My background in software engineering — a
          world of precision and problem-solving — perhaps unsurprisingly shapes how I approach every frame. There's
          something about the discipline of it — really <em>looking</em> at the light, the composition, the timing — that
          changes how you move through a place.
        </p>
        <p>
          I'm drawn to what's natural and unposed: the way late afternoon light falls across open ground, the
          personality in an animal's stillness, the energy of a crowd mid-moment. This portfolio gathers work from
          personal projects and travels — a mix of everyday trips seen through a photographer's eye and journeys planned
          around the pursuit of a good shot.
        </p>

        <!--<p>-->
        <!--  This is your space to connect with the people who find your work.-->
        <!--</p>-->
      </div>

      <a href="/" class="about-back fade-up fade-up-delay-3">← View Work</a>
    </div>
  </div>
</Layout>

<style>
  .about-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 3rem 4rem;
    position: relative;
  }

  .about-page::before {
    content: '';
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at 70% 40%, rgba(200,169,110,0.04) 0%, transparent 65%);
    pointer-events: none;
  }

  .about-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .about-label {
    font-size: 0.58rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
    opacity: 0;
  }

  .about-heading {
    font-family: var(--garamond);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--paper);
    letter-spacing: -0.01em;
    opacity: 0;
  }

  .about-heading em {
    color: rgba(245,242,236,0.5);
    font-style: italic;
  }

  .about-divider {
    width: 48px;
    height: 1px;
    background: var(--accent);
    margin: 2.5rem 0;
    opacity: 0;
  }

  .about-body {
    opacity: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-body p {
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.75;
    color: rgba(245,242,236,0.65);
    font-weight: 300;
  }

  .about-back {
    display: inline-block;
    margin-top: 3rem;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s;
    opacity: 0;
  }

  .about-back:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .about-page {
      padding: 6rem 1.5rem 3rem;
    }
    .about-heading {
      font-size: 2.2rem;
    }
  }
</style>
