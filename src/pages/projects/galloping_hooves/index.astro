---
import Layout from "../../../components/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const shoots = (await getCollection("equestrian"))
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Galloping Hooves">
  <Navbar logoLine1="Galloping Hooves" logoLine2="" instagramUrl="https://www.instagram.com/gallopinghoovesphotos" logoHref="/projects/galloping_hooves"/>

  <!-- Hero -->
  <section class="eq-hero">
    <div class="eq-hero-bg">
      <img src="/galloping_cover.jpg" alt="Gallping Hooves" class="eq-hero-img" id="eq-hero-image" />
    </div>
    <div class="eq-hero-overlay"></div>
    <div class="eq-hero-content">
      <h1 class="eq-title fade-up fade-up-delay-1">Galloping Hooves</h1>
      <p class="eq-subtitle fade-up fade-up-delay-2">
        The bond between horse and rider
      </p>
      <div class="eq-divider fade-up fade-up-delay-2"></div>
      <a href="#albums" class="eq-scroll fade-up fade-up-delay-3">
        <span>View Work</span>
        <svg width="12" height="20" viewBox="0 0 12 20" fill="none">
          <line x1="6" y1="0" x2="6" y2="18" stroke="currentColor" stroke-width="1"/>
          <polyline points="2,13 6,18 10,13" stroke="currentColor" stroke-width="1" fill="none"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Albums -->
  <section class="eq-albums" id="albums">
    <div class="eq-albums-header fade-up">
      <div class="header-line"></div>
      <h2 class="eq-albums-title">Selected Work</h2>
      <div class="header-line"></div>
    </div>

    {shoots.length > 0 ? (
      <div class="eq-masonry">
        {shoots.map((shoot, i) => (
          <a
            href={`/projects/galloping_hooves/${shoot.slug}`}
            class="eq-card"
            style={`animation-delay: ${0.3 + i * 0.12}s`}
          >
            <div class="eq-card-image-wrap">
              <Image
                src={shoot.data.cover}
                alt={shoot.data.title}
                class="eq-card-image"
                loading="lazy"
              />
              <div class="eq-card-overlay">
                <span class="eq-card-cta">View Series →</span>
              </div>
            </div>
            <div class="eq-card-info">
              <h3 class="eq-card-name">{shoot.data.title}</h3>
              {shoot.data.description && (
                <p class="eq-card-desc">{shoot.data.description}</p>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="eq-empty">No shoots yet — add folders to <code>src/content/equestrian/</code></p>
    )}
  </section>

  <footer class="eq-footer">
    <span class="footer-line"></span>
    <p class="footer-text">© {new Date().getFullYear()} · Galloping Hooves</p>
    <span class="footer-line"></span>
  </footer>
</Layout>

<script>
  const hero = document.querySelector('.eq-hero') as HTMLElement;
  const img = document.getElementById('eq-hero-image') as HTMLElement;
  const STRENGTH = 18;
  let targetX = 0, targetY = 0, currentX = 0, currentY = 0;

  function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

  function animate() {
    currentX = lerp(currentX, targetX, 0.06);
    currentY = lerp(currentY, targetY, 0.06);
    img.style.transform = `scale(1.08) translate(${currentX}px, ${currentY}px)`;
    requestAnimationFrame(animate);
  }

  hero.addEventListener('mousemove', (e: MouseEvent) => {
    const { left, top, width, height } = hero.getBoundingClientRect();
    const nx = ((e.clientX - left) / width - 0.5) * 2;
    const ny = ((e.clientY - top) / height - 0.5) * 2;
    targetX = -nx * STRENGTH;
    targetY = -ny * STRENGTH;
  });

  hero.addEventListener('mouseleave', () => { targetX = 0; targetY = 0; });
  animate();
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────────── */
  .eq-hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--eq-dark);
  }

  .eq-hero-bg {
    position: absolute;
    inset: 0;
  }

  .eq-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.08);
    will-change: transform;
    filter: contrast(1.05) saturate(0.9);
  }

  .eq-hero-overlay {
    background: linear-gradient(
      160deg,
      rgba(26,15,20,0.55) 0%,
      rgba(26,15,20,0.15) 50%,
      rgba(26,15,20,0.8) 100%
    );

  }


  .eq-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 1.5rem;
  }

  .eq-eyebrow {
    font-family: var(--sans);
    font-size: 0.6rem;
    font-weight: 300;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--eq-gold);
    margin-bottom: 1.25rem;
    opacity: 0;
  }

  .eq-title {
    font-family: var(--serif);
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: 0.06em;
    color: var(--eq-cream);
    text-transform: uppercase;
    opacity: 0;
  }

  .eq-subtitle {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    text-shadow: 0 5px 25px rgba(26,15,20,0.9), 0 0 40px rgba(26,15,20,0.7);
    font-size: clamp(1.2rem, 2.5vw, 1.4rem);
    color: white;
    //color: rgba(240, 225, 200, 0.55);
    margin-top: 1.25rem;
    opacity: 0;

  }

  .eq-divider {
    width: 40px;
    height: 1px;
    background: var(--eq-chestnut);
    margin: 2rem auto 0;
    opacity: 0;
  }

  .eq-scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    color: white;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
  }

  .eq-scroll:hover { color: var(--eq-mist); }

  /* ── Albums ───────────────────────────────────────────────────────────────── */
  .eq-albums {
    padding: 7rem 3rem 5rem;
    max-width: 1280px;
    margin: 0 auto;
  }

  .eq-albums-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 4.5rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.2s cubic-bezier(0.22,1,0.36,1) forwards;
  }

  .header-line {
    flex: 1;
    height: 1px;
    background: rgba(240, 225, 200, 0.1);
  }

  .eq-albums-title {
    font-family: var(--sans);
    font-size: 0.6rem;
    font-weight: 300;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--eq-gold);
    white-space: nowrap;
  }

  .eq-masonry {
    columns: 2;
    column-gap: 1.5rem;
  }
  @media (min-width: 900px) { .eq-masonry { columns: 3; } }

  .eq-card {
    display: block;
    break-inside: avoid;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.8s cubic-bezier(0.22,1,0.36,1) forwards;
  }

  .eq-card-image-wrap {
    position: relative;
    overflow: hidden;
    background: #1a1510;
  }

  .eq-card-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    filter: sepia(15%) contrast(1.05);
  }

  .eq-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 12, 5, 0.5);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .eq-card-cta {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--eq-gold);
    border-bottom: 1px solid var(--eq-gold);
    padding-bottom: 2px;
  }

  .eq-card:hover .eq-card-image { transform: scale(1.05); }
  .eq-card:hover .eq-card-overlay { opacity: 1; }

  .eq-card-info { padding: 1rem 0 0; }

  .eq-card-name {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--eq-cream);
    letter-spacing: 0.02em;
  }

  .eq-card-desc {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(240, 225, 200, 0.4);
    margin-top: 0.35rem;
  }

  .eq-empty {
    font-family: var(--serif);
    font-style: italic;
    color: rgba(240,225,200,0.4);
    text-align: center;
    padding: 4rem 0;
  }
  .eq-empty code {
    font-family: monospace;
    font-style: normal;
    font-size: 0.85rem;
    color: var(--eq-gold);
  }

  /* ── Footer ───────────────────────────────────────────────────────────────── */
  .eq-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 3rem;
    max-width: 1280px;
    margin: 0 auto;
  }

  .footer-line {
    flex: 1;
    height: 1px;
    background: rgba(240,225,200,0.07);
  }

  .footer-text {
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240,225,200,0.2);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .eq-albums { padding: 5rem 1.5rem 3rem; }
    .eq-masonry { columns: 1; }
  }
</style>
