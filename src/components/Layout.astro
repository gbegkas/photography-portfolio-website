---
import '../styles/global.css';
const { title = "Light & Lens" } = Astro.props;
// import { BASE_URL } from '../../astro:config';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
