---
const { image, title, subtitle } = Astro.props;
---

<section class="hero">
  <div class="hero-image-wrap">
    <img src={image} alt={title} class="hero-image" />
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content">
    <p class="hero-eyebrow fade-up">George Begkas</p>
    <h1 class="hero-title fade-up fade-up-delay-1">{title}</h1>
    {subtitle && (
      <p class="hero-subtitle fade-up fade-up-delay-2">{subtitle}</p>
    )}
    <a href="#albums" class="hero-scroll fade-up fade-up-delay-3">
      <span>View Work</span>
      <svg width="12" height="20" viewBox="0 0 12 20" fill="none">
        <line x1="6" y1="0" x2="6" y2="18" stroke="currentColor" stroke-width="1"/>
        <polyline points="2,13 6,18 10,13" stroke="currentColor" stroke-width="1" fill="none"/>
      </svg>
    </a>
  </div>

  <div class="hero-meta">
    <span class="hero-meta-line"></span>
    <span class="hero-meta-text">Scroll</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-image-wrap {
    position: absolute;
    inset: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.04);
    animation: heroZoom 12s ease-out forwards;
  }

  @keyframes heroZoom {
    to { transform: scale(1); }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(14,13,11,0.55) 0%,
      rgba(14,13,11,0.2) 50%,
      rgba(14,13,11,0.7) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 1.5rem;
  }

  .hero-eyebrow {
    font-family: var(--sans);
    font-size: 0.6rem;
    font-weight: 300;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
    opacity: 0;
  }

  .hero-title {
    font-family: var(--serif);
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--paper);
    text-shadow: 0 2px 40px rgba(0,0,0,0.3);
    opacity: 0;
  }

  .hero-subtitle {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    color: rgba(245,242,236,0.7);
    margin-top: 1rem;
    opacity: 0;
  }

  .hero-scroll {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3.5rem;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(245,242,236,0.5);
    transition: color 0.25s;
    opacity: 0;
  }

  .hero-scroll:hover {
    color: var(--accent);
  }

  .hero-meta {
    position: absolute;
    bottom: 2.5rem;
    right: 3rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    z-index: 2;
    opacity: 0;
    animation: fadeUp 0.9s 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-meta-line {
    display: block;
    width: 40px;
    height: 1px;
    background: rgba(245,242,236,0.3);
  }

  .hero-meta-text {
    font-size: 0.55rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(245,242,236,0.35);
  }
</style>
